"""End-to-end demo verification for School ERP - uses stdlib only."""
import json, sys, urllib.request, urllib.parse
from datetime import date, timedelta

BASE = "http://127.0.0.1:8000"
results = []
PASSWORD = "admin123"

def log(module, test, status, detail=""):
    results.append({"module": module, "test": test, "status": status, "detail": str(detail)[:200]})
    print(f"[{status}] {module} | {test}: {detail}")

def _req(method, path, token=None, body=None, params=None):
    url = f"{BASE}{path}"
    if params:
        qs = urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
        url = f"{url}?{qs}"
    data = None
    headers = {}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            raw = resp.read()
            try:
                return resp.status, json.loads(raw)
            except Exception:
                return resp.status, raw.decode(errors="replace")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read())
        except Exception:
            return e.code, e.read().decode(errors="replace")
    except Exception as e:
        return 0, str(e)

def G(tok, path, params=None):
    s, j = _req("GET", path, tok, params=params)
    return type("R", (), {"status_code": s, "json": lambda: j, "text": str(j)})()

def P(tok, path, j=None, params=None):
    s, j = _req("POST", path, tok, j, params=params)
    return type("R", (), {"status_code": s, "json": lambda: j, "text": str(j)})()

def U(tok, path, j=None, params=None):
    s, j = _req("PUT", path, tok, j, params=params)
    return type("R", (), {"status_code": s, "json": lambda: j, "text": str(j)})()

def D(tok, path, params=None):
    s, j = _req("DELETE", path, tok, params=params)
    return type("R", (), {"status_code": s, "json": lambda: j, "text": str(j)})()

def _r(status, j):
    return type("R", (), {"status_code": status, "json": lambda: j, "text": str(j)})()

def login(email, pw=PASSWORD):
    try:
        data = urllib.parse.urlencode({"username": email, "password": pw}).encode()
        req = urllib.request.Request(f"{BASE}/auth/token", data=data, method="POST")
        req.add_header("Content-Type", "application/x-www-form-urlencoded")
        with urllib.request.urlopen(req, timeout=10) as resp:
            j = json.loads(resp.read())
            return j.get("access_token")
    except Exception as e:
        log("AUTH", f"Login {email}", "FAIL", str(e))
    return None

def check(module, test, resp, ok_codes, detail=""):
    ok = resp.status_code in ok_codes
    log(module, test, "PASS" if ok else "FAIL", f"{resp.status_code} {detail} {resp.text if not ok else ''}".strip()[:200])
    return ok

