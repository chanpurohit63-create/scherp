BASE = "http://localhost:8000"
results = []

def log(w, t, s, d=""):
    results.append({"w":w,"t":t,"s":s,"d":d})
    emoji = "\u2705" if s=="PASS" else "\u274c" if s=="FAIL" else "\u26a0"
    print(f"{emoji} [{w}] {t}: {d}")

def login(email, pw):
    r = requests.post(f"{BASE}/auth/token", data={"username":email,"password":pw})
    return r.json()["access_token"] if r.status_code==200 else None

def H(tok): return {"Authorization": f"Bearer {tok}"}
def G(tok, path, params=None): return requests.get(f"{BASE}{path}", headers=H(tok), params=params)
def P(tok, path, j=None, params=None): return requests.post(f"{BASE}{path}", headers=H(tok), json=j, params=params)
def U(tok, path, j=None, params=None): return requests.put(f"{BASE}{path}", headers=H(tok), json=j, params=params)

def register(sa_token, school_id, email, password, full_name, role):
    """Register user and return user_id"""
    r = P(sa_token, f"/auth/register?school_id={school_id}", j={"email":email,"password":password,"full_name":full_name,"role":role})
    if r.status_code in (200,201):
        return r.json().get("id")
    if "exist" in r.text.lower():
        # User exists, find user_id via login
        tok = login(email, password)
        if tok:
            r2 = G(tok, "/users/me")
            if r2.status_code == 200:
                return r2.json().get("id")
    return None

